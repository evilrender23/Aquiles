import { expect, test } from "bun:test";
import { calcImp, totalesFactura } from "../src/index";

test("calcImp con el tipo general por defecto", () => {
  expect(calcImp(100)).toBe(21);
});

test("calcImp redondea a céntimos", () => {
  expect(calcImp(19.99, "reducido")).toBe(2);
});

test("totales de una factura", () => {
  expect(totalesFactura([{ concepto: "a", precio: 10, unidades: 2, tipo: "general" }])).toEqual({
    base: 20,
    cuota: 4.2,
    total: 24.2,
  });
});
