{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aquiles",
  "version": "0.0.1",
  "identifier": "dev.aquiles.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aquiles",
        "width": 1100,
        "height": 760,
        "minWidth": 520,
        "minHeight": 400,
        "decorations": false,
        "visible": false,
        "focus": false
      },
      {
        "label": "rapida",
        "title": "Entrada rápida",
        "url": "index.html?vista=rapida",
        "width": 640,
        "height": 140,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws: wss:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-src http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/aquiles-nucleo"],
    "resources": { "../../../skills/": "skills/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "signCommand": {
        "cmd": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "firmar.ps1", "%1"]
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "displayLanguageSelector": false
      }
    }
  }
}
