{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Ventana principal: la barra de título propia, elegir carpeta, notificaciones, traerse al frente, señalar ficheros y abrir carpetas en el Explorador, arranque con Windows, cambiar el atajo y todos los comandos propios. El núcleo se lanza desde Rust.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-focus",
    "dialog:allow-open",
    "notification:default",
    "autostart:default",
    "opener:allow-reveal-item-in-dir",
    "allow-conexion-nucleo",
    "allow-perfil-actual",
    "allow-cambiar-perfil",
    "allow-remoto-actual",
    "allow-conectar-remoto",
    "allow-desconectar-remoto",
    "allow-guardar-clave",
    "allow-hay-clave",
    "allow-borrar-clave",
    "allow-mostrar-principal",
    "allow-abrir-carpeta",
    "allow-atajo-actual",
    "allow-cambiar-atajo",
    "allow-buscar-actualizacion",
    "allow-instalar-actualizacion",
    "allow-estado-actualizacion",
    "allow-aplicar-actualizacion",
    "allow-actualizar-solo",
    "allow-cambiar-actualizar-solo"
  ]
}
